---
import { resume } from '../lib/resume';
const home = Astro.url.pathname === '/';
const items = resume.sections.map((s) => ({ href: `${home ? '' : '/'}#${s.id}`, label: s.title }));
---
<header class="hdr">
  <div class="wrap bar">
    <a href="/" class="logo mono" aria-label={`${resume.name}, home`}>salehi<span class="caret">_</span></a>
    <nav aria-label="Main">
      <ul>
        {items.map((n) => (
          <li><a href={n.href}>{n.label}</a></li>
        ))}
      </ul>
      <button class="theme" type="button" aria-label="Toggle color theme" title="Toggle theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" class="sun" />
          <path class="sun" d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
          <path class="moon" d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
        </svg>
      </button>
    </nav>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>

<script is:inline>
  document.querySelector('.theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const cur = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = cur === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  // Highlight the nav link of the section currently in view.
  (() => {
    const links = new Map([...document.querySelectorAll('.hdr nav a[href*="#"]')].map((a) => [a.hash.slice(1), a]));
    const secs = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean);
    if (!secs.length || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    secs.forEach((s) => io.observe(s));
  })();
</script>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .logo { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  .caret { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  nav { display: flex; align-items: center; gap: 4px; }
  nav ul { display: flex; gap: 2px; }
  nav a { display: block; padding: 6px 10px; border-radius: 8px; font-size: 14.5px; color: var(--muted); transition: color .15s, background .15s; }
  nav a:hover { color: var(--text); background: var(--bg-sunk); }
  nav a[aria-current] { color: var(--text); background: var(--accent-soft); }
  .progress {
    position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent);
    transform-origin: 0 50%; transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .progress { animation: grow linear both; animation-timeline: scroll(root); }
    @keyframes grow { to { transform: scaleX(1); } }
  }
  @media print { .hdr { display: none; } }
  .theme { display: grid; place-items: center; width: 36px; height: 36px; margin-left: 4px; border-radius: 8px; border: 1px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; }
  .theme:hover { color: var(--text); border-color: var(--line-strong); }
  .theme svg { width: 17px; height: 17px; }
  .moon { display: none; }
  :global(:root[data-theme='dark']) .sun { display: none; }
  :global(:root[data-theme='dark']) .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun { display: none; }
    :global(:root:not([data-theme='light'])) .moon { display: block; }
  }
  nav ul { overflow-x: auto; scrollbar-width: none; }
  nav ul::-webkit-scrollbar { display: none; }
  @media (max-width: 560px) { .logo { display: none; } .bar { justify-content: flex-end; } nav { width: 100%; justify-content: space-between; } nav a { padding: 6px 8px; font-size: 14px; } }
  @media (max-width: 360px) { nav a { padding: 6px 5px; font-size: 13px; } }
</style>
