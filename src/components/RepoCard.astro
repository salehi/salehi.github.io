---
import { langColor, fmtMonth, type Repo } from '../lib/github';
interface Props {
  repo: Repo;
  description?: string | null;
  live?: string;
  docker?: string;
  compact?: boolean;
}
const { repo, description = repo.description, live, docker, compact = false } = Astro.props;
const color = repo.language ? langColor[repo.language] ?? 'var(--faint)' : undefined;
---
<article class:list={['card', { compact }]}>
  <h3 class="mono">
    <a href={repo.html_url} class="stretch">{repo.name}</a>
    {repo.fork && <span class="fork">fork</span>}
  </h3>
  {description ? <p class="desc">{description}</p> : !compact && <p class="desc none">No description.</p>}
  <div class="meta mono">
    {repo.language && <span class="lang"><i style={`background:${color}`}></i>{repo.language}</span>}
    {repo.stargazers_count > 0 && (
      <span title="Stars"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.3l2 4.1 4.5.6-3.3 3.2.8 4.5L8 11.6l-4 2.1.8-4.5L1.5 6l4.5-.6z"/></svg>{repo.stargazers_count}</span>
    )}
    <span class="date">{fmtMonth(repo.pushed_at)}</span>
    {(live || docker) && (
      <span class="ext">
        {live && <a href={live} class="pill">live ↗</a>}
        {docker && <a href={docker} class="pill">docker ↗</a>}
      </span>
    )}
  </div>
</article>

<style>
  .card {
    position: relative; display: flex; flex-direction: column; gap: 10px;
    padding: 20px; border-radius: var(--radius);
    background: var(--bg-elev); border: 1px solid var(--line);
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .card:hover { border-color: var(--line-strong); box-shadow: var(--shadow); transform: translateY(-2px); }
  .card:has(.stretch:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  h3 { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; display: flex; gap: 8px; align-items: center; min-width: 0; }
  h3 a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stretch::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .stretch:focus-visible { outline: none; }
  .card:hover h3 a { color: var(--accent); }
  .fork { font-size: 11px; font-weight: 500; color: var(--faint); border: 1px solid var(--line); border-radius: 5px; padding: 0 5px; }
  .desc { color: var(--muted); font-size: 14.5px; line-height: 1.55; flex: 1; }
  .desc.none { color: var(--faint); font-style: italic; }
  .compact .desc { font-size: 14px; }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; color: var(--faint); }
  .meta span { display: inline-flex; align-items: center; gap: 5px; }
  .lang i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  .meta svg { width: 12px; height: 12px; fill: currentColor; }
  .ext { margin-left: auto; gap: 6px !important; }
  .pill { position: relative; z-index: 1; padding: 2px 8px; border-radius: 6px; border: 1px solid var(--line); color: var(--muted); transition: color .15s, border-color .15s; }
  .pill:hover { color: var(--accent); border-color: var(--accent); }
</style>
