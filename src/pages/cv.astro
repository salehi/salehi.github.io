---
import Base from '../layouts/Base.astro';
import { cv } from '../data/cv';
import { site } from '../data/site';
---
<Base title="Résumé" description={`${cv.title}. ${cv.summary}`}>
  <div class="wrap page">
    <div class="actions no-print">
      <p class="eyebrow"><b>~/</b>résumé</p>
      <a class="btn primary" href={site.cvPdf} download>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 19h16"/></svg>
        Download PDF
      </a>
    </div>

    <article class="sheet">
      <header class="top">
        <h1>{cv.name}</h1>
        <p class="title">{cv.title}</p>
        <p class="summary">{cv.summary}</p>
        <p class="contacts">
          <span>{cv.location}</span>
          {cv.contacts.map((c) => <a href={c.href}>{c.label}</a>)}
        </p>
      </header>

      <section>
        <h2>Engineering profile</h2>
        <p>{cv.profile}</p>
      </section>

      <section>
        <h2>Core capabilities</h2>
        <table class="caps">
          <tbody>
            {cv.capabilities.map((c) => (
              <tr><th scope="row">{c.area}</th><td>{c.items.join(' · ')}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h2>Selected engineering work</h2>
        <ul class="work">
          {cv.selectedWork.map((w) => <li><b>{w.name}</b> — {w.text}</li>)}
        </ul>
      </section>

      <section>
        <h2>Professional experience</h2>
        <ol class="jobs">
          {cv.experience.map((e) => (
            <li>
              <div class="jh"><h3>{e.company} — {e.role}</h3><span class="when">{e.period}</span></div>
              <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
            </li>
          ))}
        </ol>
        <p class="note">{cv.earlier}</p>
      </section>

      <section>
        <h2>Languages &amp; certification</h2>
        <p>{cv.languages.join(' · ')}</p>
      </section>
    </article>
  </div>
</Base>

<style>
  .page { padding-block: 40px 96px; }
  .actions { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .sheet {
    --cv-accent: var(--accent);
    max-width: 880px; margin-inline: auto;
    background: var(--bg-elev); border: 1px solid var(--line); border-radius: var(--radius);
    border-top: 4px solid var(--cv-accent);
    padding: clamp(22px, 5vw, 56px); box-shadow: var(--shadow);
    font-size: 15px; line-height: 1.55;
  }
  .top { display: grid; gap: 6px; margin-bottom: 8px; }
  h1 { font-size: clamp(30px, 5vw, 42px); letter-spacing: -0.03em; }
  .title { font-family: var(--font-mono); font-size: 14px; letter-spacing: .06em; text-transform: uppercase; color: var(--cv-accent); font-weight: 600; }
  .summary { font-size: 16.5px; margin-top: 6px; }
  .contacts { display: flex; flex-wrap: wrap; gap: 4px 0; color: var(--muted); font-size: 13.5px; margin-top: 6px; }
  .contacts > * + *::before { content: '·'; margin: 0 8px; color: var(--faint); }
  .contacts a:hover { color: var(--cv-accent); }
  section { margin-top: 28px; }
  h2 { font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--cv-accent); font-weight: 600; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .caps { width: 100%; border-collapse: collapse; }
  .caps th, .caps td { text-align: left; vertical-align: top; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .caps th { width: 140px; font-weight: 550; padding-right: 16px; white-space: nowrap; }
  .caps td { color: var(--muted); }
  @media (max-width: 560px) { .caps th, .caps td { display: block; width: auto; border: 0; padding: 0; } .caps tr { display: block; padding: 8px 0; border-bottom: 1px solid var(--line); } }
  .work { display: grid; gap: 8px; }
  .work b { font-weight: 600; }
  .jobs { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .jh { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  h3 { font-size: 15.5px; font-weight: 650; letter-spacing: -0.01em; }
  .when { font-family: var(--font-mono); font-size: 12.5px; color: var(--faint); white-space: nowrap; }
  .jobs ul { list-style: disc; padding-left: 18px; color: var(--muted); margin-top: 3px; }
  .note { margin-top: 14px; color: var(--faint); font-size: 13.5px; }

  @media print {
    @page { size: A4; margin: 12mm 13mm; }
    :global(.hdr), :global(.ftr), :global(.skip), .no-print { display: none !important; }
    :global(html), :global(body) { background: #fff !important; color: #1b2228 !important; }
    .page { padding: 0; max-width: none; }
    .sheet {
      --cv-accent: #0e6e80;
      --line: #dde1e4; --muted: #3b454d; --faint: #6b757d; --text: #1b2228;
      border: 0; border-top: 4px solid var(--cv-accent); border-radius: 0; box-shadow: none; background: #fff;
      padding: 14px 0 0; max-width: none; font-size: 10.6pt; line-height: 1.42;
    }
    h1 { font-size: 26pt; } .summary { font-size: 11.5pt; }
    section { margin-top: 14px; break-inside: auto; }
    .jobs > li { break-inside: avoid; }
    h2 { margin-bottom: 6px; break-after: avoid; }
    .caps th, .caps td { padding: 4px 0; font-size: 10pt; }
    .jobs { gap: 8px; }
    a { color: inherit !important; }
  }
</style>
