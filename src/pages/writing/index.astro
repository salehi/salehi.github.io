---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('writing', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Writing" description="Technical notes and write-ups by salehi.">
  <section class="wrap page">
    <header class="section-head">
      <p class="eyebrow"><b>~/</b>writing</p>
      <h1>Writing</h1>
      <p>Technical notes, incident write-ups and things learned in production.</p>
    </header>
    {posts.length === 0 ? <p class="muted">Nothing published yet.</p> : (
      <ul class="list">
        {posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>
              <time class="mono" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="t">{p.data.title}</span>
              <span class="d">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
<style>
  .page { padding-block: 56px 96px; }
  h1 { font-size: clamp(36px, 5.6vw, 56px); letter-spacing: -0.035em; }
  .list { border-top: 1px solid var(--line); }
  .list a { display: grid; gap: 4px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  time { font-size: 12.5px; color: var(--faint); }
  .t { font-size: 19px; font-weight: 600; letter-spacing: -0.015em; }
  .d { color: var(--muted); }
  .list a:hover .t { color: var(--accent); }
</style>
