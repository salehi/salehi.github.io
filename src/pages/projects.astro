---
import Base from '../layouts/Base.astro';
import RepoCard from '../components/RepoCard.astro';
import { favorites } from '../data/favorites';
import { getRepos, META_REPOS } from '../lib/github';

const repos = (await getRepos()).filter((r) => !META_REPOS.has(r.name));
const byName = new Map(repos.map((r) => [r.name, r]));
const favs = favorites.filter((f) => byName.has(f.repo));
const favSet = new Set(favs.map((f) => f.repo));
const others = repos.filter((r) => !r.fork && !favSet.has(r.name));
const forks = repos.filter((r) => r.fork && !favSet.has(r.name));
---
<Base title="Projects" description="Favorite projects and every public repository by salehi.">
  <section class="wrap page">
    <header class="section-head">
      <p class="eyebrow"><b>~/</b>projects</p>
      <h1>Projects</h1>
      <p>Favorites first, then every public repository, newest activity first.</p>
    </header>

    <h2 class="sub mono"><span>Favorites</span><span class="n">{favs.length}</span></h2>
    <div class="cards">
      {favs.map((f) => <RepoCard repo={byName.get(f.repo)!} description={f.description} live={f.live} docker={f.docker} />)}
    </div>

    <h2 class="sub mono"><span>Other repositories</span><span class="n">{others.length}</span></h2>
    <div class="cards">
      {others.map((r) => <RepoCard repo={r} compact />)}
    </div>

    {forks.length > 0 && (
      <details class="forks">
        <summary class="sub mono"><span>Forks</span><span class="n">{forks.length}</span><span class="hint">show</span></summary>
        <div class="cards">
          {forks.map((r) => <RepoCard repo={r} compact />)}
        </div>
      </details>
    )}
  </section>
</Base>

<style>
  .page { padding-block: 56px 96px; }
  h1 { font-size: clamp(36px, 5.6vw, 56px); letter-spacing: -0.035em; }
  .sub { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 500; color: var(--muted); margin: 48px 0 16px; padding-bottom: 10px; border-bottom: 1px solid var(--line); letter-spacing: .02em; }
  .n { color: var(--faint); border: 1px solid var(--line); border-radius: 6px; padding: 0 6px; font-size: 12px; }
  .cards { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .forks summary { cursor: pointer; list-style: none; }
  .forks summary::-webkit-details-marker { display: none; }
  .hint { margin-left: auto; color: var(--accent); }
  .forks[open] .hint { visibility: hidden; }
  .forks summary:hover { color: var(--text); }
</style>
